{
  "expo": {
    "name": "Bad(yet)",
    "slug": "badyet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "badyet",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1220",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.docoats.badyet",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-background-task",
      "expo-image",
      "expo-image-picker"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a37fb64f-8dac-4ed0-a222-984d2bfd36b1"
      }
    },
    "owner": "docoats",
    "updates": {
      "url": "https://u.expo.dev/a37fb64f-8dac-4ed0-a222-984d2bfd36b1"
    },
    "ios": {}
  }
}
