# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The only email allowed to log in (server-side only, not exposed to the browser)
ALLOWED_EMAIL=you@example.com
# Optional: public site URL used in magic links (defaults to the request origin)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Seed script only (arrives later, local use only, never deploy this one):
# SUPABASE_SERVICE_ROLE_KEY=
